library(ggplot2)
ggplot(df_sub, aes(x = lat, y = CLASS)) +
geom_jitter(height = 0.2, alpha = 0.4) +
theme_minimal()
# choose band size; feel free to adjust
bw <- 2   # 2-degree bands
lat_breaks <- seq(
floor(min(df_sub$lat, na.rm = TRUE)),
ceiling(max(df_sub$lat, na.rm = TRUE)),
by = bw
)
df_sub$lat_band <- cut(df_sub$lat, breaks = lat_breaks, include.lowest = TRUE)
tab <- prop.table(table(df_sub$lat_band, df_sub$CLASS), 1)  # row proportions
tab
tab_df <- as.data.frame(tab)
colnames(tab_df) <- c("lat_band", "CLASS", "prop")
ggplot(tab_df, aes(x = CLASS, y = lat_band, fill = prop)) +
geom_tile() +
scale_fill_viridis_c() +
theme_minimal() +
labs(fill = "Proportion",
y = "Latitude band",
x = "CLASS")
library(nnet)
df_sub$CLASS <- droplevels(df_sub$CLASS)
m_mult <- multinom(CLASS ~ lat, data = df_sub)
summary(m_mult)
# pseudo R^2 (McFadden)
ll_null <- logLik(multinom(CLASS ~ 1, data = df_sub))
ll_full <- logLik(m_mult)
pseudoR2 <- 1 - as.numeric(ll_full / ll_null)
pseudoR2
# How often do we predict the correct CLASS from lat alone?
pred_class <- predict(m_mult, newdata = df_sub)
mean(pred_class == df_sub$CLASS)
library(vegan)
adonis_lat <- adonis2(dist_mat ~ lat, data = df_sub, permutations = 999)
adonis_lat
adonis_both <- adonis2(dist_mat ~ CLASS + lat, data = df_sub,
permutations = 999, by = "margin")
adonis_both
df <- read.csv("/Users/claregaffey/Documents/SCOPE/CruiseData/seascape_outputs/IFCB_G5_taxon_biomass_latgrad_grid5_16daytoler_seascapesV2026v2.csv")
comp_cols <- c("Bacillariophyceae",	"Chlorophyta",  "Cryptophyta", "Cyanobacteria",  "Dictyochophyceae", "Dinophyceae", "Euglenozoa",  "Haptophyta")#Unidentifiable","Detritus",, "Meta""Arthropoda", # Mixotrophic zookplanktn:"Ciliophora","Foraminifera", , "Radiozoa"
class_col <- "CLASS"
## ---- PACKAGES -----------------------------------------------------------
#install.packages("nnet")
#install.packages(c("compositions", "zCompositions", "car"))
#install.packages(c("robustbase", "FRB"))  # for robust section (optional)
## ---- PACKAGES ----
library(compositions)
library(zCompositions)  # for zero replacement
library(vegan)          # for adonis2 PERMANOVA
## ---- 1. SUBSET / CLEAN DATA ----
vars_needed <- c(comp_cols, class_col, "lat")
df_sub <- df[complete.cases(df[, vars_needed]), vars_needed]
df_sub[[class_col]] <- as.factor(df_sub[[class_col]])
## ---- 2. AITCHISON DISTANCE FROM COMPOSITION ----
Y_raw   <- as.matrix(df_sub[, comp_cols])
Y_nz    <- cmultRepl(Y_raw, method = "CZM")  # zero replacement
Y_acomp <- acomp(Y_nz)
# I’ll use ilr + Euclidean = Aitchison distance
Y_ilr   <- ilr(Y_acomp)
dist_mat <- dist(Y_ilr, method = "euclidean")  # Aitchison
#$$$
## ---- 3. BASIC PERMANOVA: composition ~ CLASS ----
set.seed(123)
perm_basic <- adonis2(
dist_mat ~ df_sub[[class_col]],
permutations = 999
)
perm_basic
# This answers: "Do compositions differ among CLASS levels?"
## ---- 4. PERMANOVA WITH LATITUDE AS COVARIATE ----
# Model: composition ~ CLASS + lat
# Tests CLASS while adjusting for linear lat trend
set.seed(123)
perm_lat_cov <- adonis2(
dist_mat ~ df_sub[[class_col]] + df_sub$lat,
permutations = 999
)
perm_lat_cov
# Look at the row for df_sub[[class_col]]: effect of CLASS after accounting for lat.
## ---- 5. RESTRICTED PERMUTATIONS BY LATITUDE BANDS ----
# Make latitude bands (e.g. 2-degree bands; tweak 'by' as you like)
lat_breaks <- seq(
floor(min(df_sub$lat, na.rm = TRUE)),
ceiling(max(df_sub$lat, na.rm = TRUE)),
by = 2
)
df_sub$lat_band <- cut(df_sub$lat, breaks = lat_breaks, include.lowest = TRUE)
# Use permutation "blocks" so labels are only shuffled within each lat band
library(permute)
set.seed(123)
ctrl <- how(
blocks = df_sub$lat_band,  # strata by lat band
nperm  = 999
)
perm_blocked <- adonis2(
dist_mat ~ df_sub[[class_col]],
permutations = ctrl
)
perm_blocked
