library(vegan)
## band widths (degrees) to test
band_widths <- c(0.5, 1, 2, 3, 4, 5)
bw <- 0.5
lat_breaks <- seq(
floor(min(df_sub$lat, na.rm = TRUE)),
ceiling(max(df_sub$lat, na.rm = TRUE)),
by = bw
)
df_sub$lat_band_test <- cut(df_sub$lat, breaks = lat_breaks, include.lowest = TRUE)
table(df_sub$lat_band_test)
class_col   <- "CLASS"   # adjust if your class column has a different name
run_blocked_permanova_safe <- function(bw, df_sub, dist_mat, class_col, nperm = 999) {
# 1. Define latitude bands
lat_breaks <- seq(
floor(min(df_sub$lat, na.rm = TRUE)),
ceiling(max(df_sub$lat, na.rm = TRUE)),
by = bw
)
df_sub$lat_band <- cut(df_sub$lat, breaks = lat_breaks, include.lowest = TRUE)
# 2. Drop bands with < 2 samples (can't permute meaningfully)
tab <- table(df_sub$lat_band)
keep_bands <- names(tab)[tab >= 2]
idx <- df_sub$lat_band %in% keep_bands
df2 <- droplevels(df_sub[idx, ])
if (nrow(df2) < 4) {
# too few points to do anything sensible
return(data.frame(
band_width = bw,
n_bands    = length(keep_bands),
n_used     = nrow(df2),
F_model    = NA,
R2_model   = NA,
p_value    = NA
))
}
# 3. Subset distance matrix accordingly
dist_mat_full <- as.matrix(dist_mat)
dist_sub <- as.dist(dist_mat_full[idx, idx])
# 4. Run PERMANOVA with strata = lat_band on the subset
set.seed(123)
res <- adonis2(
dist_sub ~ df2[[class_col]],
permutations = nperm,
strata       = df2$lat_band
)
res_tab <- as.data.frame(res)
data.frame(
band_width = bw,
n_bands    = length(keep_bands),
n_used     = nrow(df2),
F_model    = res_tab$F[1],
R2_model   = res_tab$R2[1],
p_value    = res_tab$`Pr(>F)`[1]
)
}
## Run across all widths
set.seed(123)
band_results <- do.call(
rbind,
lapply(
band_widths,
run_blocked_permanova_safe,
df_sub   = df_sub,
dist_mat = dist_mat,
class_col = class_col,
nperm    = 999
)
)
band_results
